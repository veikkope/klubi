# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (ignore actual values; keep .env.example as template)
.env
.env.local
.env.development.local
.env.production.local
.env.test.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# sanity
/.sanity
/dist

# migration scratch data (regenerable from old site)
/data/raw-content.json
/data/migration.ndjson

# vanhan sivuston raakakopio (regeneroitavissa crawlilla)
/data/raw-html/
/data/crawl-status.tsv
/data/external-links.txt
/data/normalized/
/sanity/extract.json
/data/images/
/data/migration-*.ndjson

# Blogspot-blogin paikallinen kopio (regeneroitavissa: npm run blogspot:fetch).
# Sisältää kommentoijien nimiä → ei versionhallintaan.
/data/blogspot/

# Sanityn varmuuskopiot (npm run backup)
/varmuuskopiot/

# Klubin ruokailutaulukko (jäsenten nimet ja arvosanat): ei versionhallintaan
*.xls
*.xlsx
/data/klubiarviot-*.csv
