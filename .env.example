# Lahden Suomalainen Klubi ry — Sanity-ympäristömuuttujat
#
# 1. Luo Sanity-projekti komennolla: npx sanity@latest init
# 2. Kopioi tämä tiedosto nimellä .env.local
# 3. Täytä projectId arvolla, jonka Sanity tulostaa
#
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01

# Vain palvelinpuolen lukutokenia (luo Sanity-projektin asetuksissa, role: Viewer).
# Käytetään esikatselussa ja Server Action -kirjoituksissa.
SANITY_API_READ_TOKEN=

# Server Action -kirjoituksiin (käyttäjäarvostelujen tallennus). Luo write-token Sanityssa.
SANITY_API_WRITE_TOKEN=

# Sanity-webhookin allekirjoitussalaisuus (app/api/revalidate).
# Luo satunnainen merkkijono ja aseta sama arvo Sanityn webhook-asetuksiin.
# Ilman tätä webhook vastaa 501:llä eikä välimuisti tyhjenny automaattisesti.
SANITY_REVALIDATE_SECRET=

# Jäsenhakemusten sähköpostilähetys (app/(public)/klubi/liity).
# Jos yksikin näistä puuttuu, lomake kertoo käyttäjälle rehellisesti ettei
# vastaanotto ole käytössä — se ei teeskentele onnistumista.
RESEND_API_KEY=
JASENHAKEMUS_VASTAANOTTAJA=
JASENHAKEMUS_LAHETTAJA=

# Otteluohjelma (lib/ottelut.ts, docs/13-otteluohjelma.md).
# Ilman avainta Veikkausliigan ottelut haetaan julkisesta kalenterisyötteestä.
# Palloliiton Taso-rajapinnan avain: vain palvelimella, ei koskaan NEXT_PUBLIC_.
TASO_API_KEY=
# Sarjat muodossa kilpailu:kategoria, pilkulla eroteltuna (oletus: kuluvan kauden Veikkausliiga).
TASO_SARJAT=
