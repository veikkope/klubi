{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm view *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "WebSearch",
      "WebFetch(domain:www.lahdensuomalainenklubi.com)",
      "WebFetch(domain:lahdensuomalainenklubi.com)",
      "WebFetch(domain:lahdensuomalainenklubi.blogspot.com)",
      "WebFetch(domain:www.sanity.io)",
      "WebFetch(domain:nextjs.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env*)",
      "Edit(./.githooks/**)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(*--no-verify*)",
      "Bash(*--replace*)",
      "Bash(npx sanity dataset delete*)",
      "Bash(*--production*)",
      "Bash(npm run sync:blogspot:production*)",
      "Bash(npm run e2e:arvioijasaanto*)",
      "Bash(npm run e2e:ohjaukset)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(npm install *)",
      "Bash(npx sanity *)",
      "Bash(vercel *)"
    ]
  },
  "enabledPlugins": {
    "tyokalut@smoot": true
  }
}
