{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npm view *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm outdated*)",
      "Bash(gh run list*)",
      "Bash(gh run view*)",
      "Bash(gh pr view*)",
      "WebSearch",
      "WebFetch(domain:www.lahdensuomalainenklubi.com)",
      "WebFetch(domain:lahdensuomalainenklubi.com)",
      "WebFetch(domain:lahdensuomalainenklubi.blogspot.com)",
      "WebFetch(domain:www.sanity.io)",
      "WebFetch(domain:nextjs.org)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Edit(./.env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(npm run sync:blogspot:production*)",
      "Bash(npm run e2e:arvioijasaanto*)",
      "Bash(npm run e2e:ohjaukset)"
    ],
    "ask": [
      "Edit(./.githooks/**)",
      "Bash(git push*)",
      "Bash(npm install *)",
      "Bash(npx sanity *)",
      "Bash(vercel *)"
    ]
  },
  "extraKnownMarketplaces": {
    "smoot": {
      "source": {
        "source": "github",
        "repo": "veikkope/claude-tyokalut"
      }
    }
  },
  "enabledPlugins": {
    "tyokalut@smoot": true
  }
}
